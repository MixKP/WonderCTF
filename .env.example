# Copy to .env and adjust. Never commit the real .env.

# --- Platform database ---
POSTGRES_USER=ctf
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ctf_platform
DATABASE_URL=postgres://ctf:change-me-locally@db:5432/ctf_platform?sslmode=disable

# --- Platform API ---
JWT_SECRET=change-me-to-a-long-random-string
PLATFORM_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080

# --- Challenge services (defaults, rarely need changing) ---
A03_INJECTION_PORT=9003
A01_PORT=9001
A02_PORT=9002
A04_PORT=9004
A05_PORT=9005
A06_PORT=9006
A07_PORT=9007
A08_PORT=9008
A09_PORT=9009
A10_PORT=9010
